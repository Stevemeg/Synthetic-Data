FROM python:3.11-slim-trixie@sha256:0dd364ba7e10242f07755449e3a3d0e35f9efd987952737b90def6709ab0c5ce AS dependencies
WORKDIR /build
COPY backend/requirements*.txt ./
RUN python -m venv /opt/venv && /opt/venv/bin/python -m pip install --upgrade pip==26.2.1 setuptools==83.0.0 && /opt/venv/bin/pip install --no-cache-dir --no-deps https://download.pytorch.org/whl/cpu/torch-2.13.0%2Bcpu-cp311-cp311-manylinux_2_28_x86_64.whl && /opt/venv/bin/pip install --no-cache-dir -r requirements-evaluation.txt && /opt/venv/bin/pip install --no-cache-dir --upgrade setuptools==83.0.0 wheel==0.46.2 urllib3==2.8.0 msgpack==1.2.1 jaraco.context==6.1.0

FROM python:3.11-slim-trixie@sha256:0dd364ba7e10242f07755449e3a3d0e35f9efd987952737b90def6709ab0c5ce AS runtime
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home medsynth
COPY --from=dependencies /opt/venv /opt/venv
# Installation tooling is unnecessary in the immutable runtime and carries vendored packages.
RUN /opt/venv/bin/python -m pip check && /opt/venv/bin/python -m pip uninstall -y pip && /usr/local/bin/python -m pip uninstall -y pip setuptools
ENV PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 APP_HOST=0.0.0.0
WORKDIR /app
COPY --chown=10001:10001 backend /app/backend
COPY --chown=10001:10001 VERSION alembic.ini /app/
RUN mkdir -p /app/backend/.work /app/backend/uploads && chown -R 10001:10001 /app/backend/.work /app/backend/uploads
ARG APP_COMMIT
ARG APP_BUILD_TIMESTAMP
ENV APP_COMMIT=$APP_COMMIT APP_BUILD_TIMESTAMP=$APP_BUILD_TIMESTAMP
USER 10001:10001

FROM runtime AS api
EXPOSE 5000
HEALTHCHECK --interval=15s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health', timeout=3)"
CMD ["python", "-m", "backend.app"]

FROM runtime AS worker
CMD ["python", "-m", "backend.worker"]
