APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
GENERATED_DATA_DIR=backend/generated_data
UPLOAD_DIR=backend/uploads
# Preserved pretrained artifacts remain in backend/ for compatibility.
MODEL_DIR=backend
LOG_LEVEL=INFO
MAX_GENERATION_SAMPLES=1000
MAX_GENERATION_IMAGES=64
MAX_SOURCE_ROWS=1000
MAX_ECG_SEGMENTS=5000
ECG_EPOCHS=10
# Must match the acquisition/resampling of your input; not inferred from CSV.
ECG_SAMPLING_RATE=125
ENABLE_IMAGING_LAB=false
# Process-level CPU threading; applied before lazy PyTorch imports.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
# Local database. Set a generated password in your ignored .env, not this file.
POSTGRES_DB=medsynth
POSTGRES_USER=medsynth
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Empty DATABASE_URL builds a local psycopg URL from POSTGRES_* above.
DATABASE_URL=
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_PATH=data/artifacts
JOB_POLL_INTERVAL=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=10
TABULAR_MAX_SOURCE_ROWS=10000
TABULAR_MAX_COLUMNS=100
TABULAR_MAX_GENERATED_ROWS=10000
TABULAR_MAX_TRANSFORMED_CELLS=2000000
CTGAN_MAX_EPOCHS=50
TVAE_MAX_EPOCHS=50
CTGAN_WARNING_MIN_ROWS=500
TVAE_WARNING_MIN_ROWS=500
TABULAR_JOB_TIMEOUT_SECONDS=300
# VERSION is the canonical application release source. Leave APP_VERSION unset.
# Optional verified build commit identifier.
APP_COMMIT=
APP_BUILD_TIMESTAMP=

# Phase 4 operational computation bounds, not scientific thresholds.
EVALUATION_TIMEOUT_SECONDS=300
DCR_MAX_ROWS=2000
DISCLOSURE_MAX_ROWS=2000
DISCLOSURE_ESTIMATE_ROWS=500
DISCLOSURE_ESTIMATE_ITERATIONS=3
QUALITY_SUBSAMPLE_ROWS=2000
UTILITY_MAX_ROWS=10000
UTILITY_MAX_ENCODED_CELLS=2000000

# Development bypass is explicit and rejected in production.
AUTH_MODE=development
APP_DEBUG=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5000/api/v1/auth/callback
# Optional private origin for discovery/token/JWKS; browser issuer stays public.
OIDC_INTERNAL_ORIGIN=
FRONTEND_URL=http://127.0.0.1:5173
SESSION_SECRET=
SESSION_HOURS=8
METRICS_TOKEN=
WORKER_METRICS_PORT=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SERVER_SIDE_ENCRYPTION=
# Local fixture services only; use generated secrets in ignored .env.
OIDC_DEV_ADMIN_USER=development-operator
OIDC_DEV_ADMIN_PASSWORD=
CONTAINER_DATABASE_URL=
